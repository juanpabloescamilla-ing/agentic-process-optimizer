{
  "display_information": {
    "name": "Process Optimizer",
    "description": "Diagnostica procesos, recomienda mejoras y estima impacto con evidencia.",
    "background_color": "#163C35"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "process-optimizer",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "channels:history",
        "im:history",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://agentic-process-optimizer-p4w9.vercel.app/api/webhooks/slack",
      "bot_events": ["app_mention", "message.channels", "message.im"]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
