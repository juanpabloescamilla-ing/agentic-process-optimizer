# Configure credentials privately in Vercel or .env.local; never commit them.
MODEL_ID=
# When set, requests go directly to OpenRouter. Use an OpenRouter model ID.
OPENROUTER_API_KEY=
# Optional on Vercel when its automatic OIDC identity can access AI Gateway.
AI_GATEWAY_API_KEY=
REDIS_URL=
SLACK_BOT_TOKEN=
SLACK_CONNECTOR=
SLACK_SIGNING_SECRET=
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_APP_TENANT_ID=
# Protect the web testing console. Channel webhooks use their platform authentication.
CONSOLE_ACCESS_TOKEN=

# Public origin used in report links, e.g. https://your-app.vercel.app
REPORT_BASE_URL=
